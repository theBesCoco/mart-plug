
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Plug Control</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <main class="container">
    <div class="top-label">ESP32 • WIFI CONTROL</div>

    <h1>SMART PLUG</h1>
    <p class="subtitle">ระบบควบคุมปลั๊กไฟอัจฉริยะ</p>

    <div class="plug">
      <svg viewBox="0 0 160 180" aria-label="รูปปลั๊กไฟ">
        <rect x="35" y="35" width="90" height="110" rx="25"
          fill="#172b49" stroke="#38bdf8" stroke-width="4"/>
        <rect x="58" y="12" width="12" height="38" rx="6" fill="#38bdf8"/>
        <rect x="90" y="12" width="12" height="38" rx="6" fill="#38bdf8"/>
        <circle cx="80" cy="90" r="19" fill="#38bdf8"/>
        <path d="M80 78 V91 L90 99" stroke="#102039"
          stroke-width="5" fill="none" stroke-linecap="round"/>
        <path d="M80 145 V165" stroke="#38bdf8"
          stroke-width="6" stroke-linecap="round"/>
      </svg>
    </div>

    <div class="status-box">
      <span class="status-label">POWER STATUS</span>
      <div id="status" class="status">OFF</div>
      <span id="indicator" class="indicator"></span>
    </div>

    <button id="powerButton" class="power-button" onclick="togglePower()">
      เปิดใช้งาน
    </button>

    <p class="footer">SMART PLUG PROJECT</p>
  </main>

  <script src="script.js"></script>
</body>
</html>

